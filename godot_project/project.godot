; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Year of Z: Iron Winter (v4.0 Novorsk-17)"
config/description="2.5D Oblique Top-Down Three-Way Stealth Survival & Bureaucratic Realism RPG"
config/version="4.0.0"
run/main_scene="res://scenes/campaign.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

SignalBus="*res://autoload/SignalBus.gd"
LogbookManager="*res://autoload/LogbookManager.gd"
AcousticRippleBus="*res://autoload/AcousticRippleBus.gd"
RaidBridge="*res://autoload/RaidBridge.gd"
SaveGame="*res://autoload/SaveGame.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

run/main_run_args="--ignore-error-breaks"

