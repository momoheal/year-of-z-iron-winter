; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Year of Z: Iron Winter (v4.0 Novorsk-17)"
config/description="2.5D Oblique Top-Down Three-Way Stealth Survival & Bureaucratic Realism RPG"
config/version="4.0.0"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

LogbookManager="*res://autoload/LogbookManager.gd"
AcousticRippleBus="*res://autoload/AcousticRippleBus.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

2d_physics/layer_1="World_Wall_Full"
2d_physics/layer_2="Low_Cover_SteamPipe"
2d_physics/layer_3="Wire_Mesh_Fence_12cm"
2d_physics/layer_4="Player_Aleksei"
2d_physics/layer_5="Companion_Ash"
2d_physics/layer_6="Infected_TriState"
2d_physics/layer_7="OSK_Purge_Squad"
2d_physics/layer_8="Interactable_Wedge_Door"

[rendering]

textures/canvas_textures/default_texture_filter=1
