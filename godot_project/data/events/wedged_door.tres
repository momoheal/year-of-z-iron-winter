[sub_resource type="Resource" id="Resource_ii85l"]
script = ExtResource("1_lh3jk")
id = "abandon"
label_zh = "放弃这扇门"
label_en = "Leave the door"
on_success = Array[ExtResource("2_jo4wk")]([SubResource("Resource_gldj4")])
result_text_zh = "你深深看了一眼门缝里的暗影，没有去惊扰那扇门后的死寂，转身继续向黑暗深处走去。"
result_text_en = "You turn and move on."

[resource]
script = ExtResource("3_sj8je")
id = "wedged_door"
title_zh = "被楔死的门"
title_en = "The Wedged Door"
desc_zh = "一扇厚重的铁皮木门被人从里面用木楔死死顶住，透过结霜的门缝，隐约能看见屋角散落着几罐还没开封的配给物资。"
desc_en = "A door is wedged from inside; loot is visible through the gap."
phase = "night"
trigger_chance = 0.95
art_tag = "probability"
options = Array[ExtResource("1_lh3jk")]([SubResource("Resource_sxe2g"), SubResource("Resource_qc2k3"), SubResource("Resource_ii85l")])
