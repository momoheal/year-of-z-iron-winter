[sub_resource type="Resource" id="Resource_qc2k3"]
script = ExtResource("1_lh3jk")
id = "break_quiet"
label_zh = "慢慢拆下楔子"
label_en = "Work the wedge out quietly"
success_chance = 0.95
costs = Array[ExtResource("2_jo4wk")]([SubResource("Resource_codtx")])
on_success = Array[ExtResource("2_jo4wk")]([SubResource("Resource_508yu")])
on_failure = Array[ExtResource("2_jo4wk")]([SubResource("Resource_d0en2")])
result_text_zh = "你屏住呼吸，用撬棍扁平的尖端顺着门缝一点点拨动，没发出一丝惊动暗处的声响便退出了木楔。"
result_text_en = "You ease the wedge out."

