[sub_resource type="Resource" id="Resource_sxe2g"]
script = ExtResource("1_lh3jk")
id = "break_force"
label_zh = "用撬棍暴力破门"
label_en = "Force it with the crowbar"
success_chance = 0.7
on_success = Array[ExtResource("2_jo4wk")]([SubResource("Resource_ofvqb"), SubResource("Resource_vlmvg")])
on_failure = Array[ExtResource("2_jo4wk")]([SubResource("Resource_0xfvj"), SubResource("Resource_rhre8")])
result_text_zh = "道钉撬棍带着回音「哐当」一声砸烂了门闩，你在满地碎木屑里翻出了前人留下的救命存货。"
result_text_en = "The door slams open."

