label_en = "Double accepted"

[sub_resource type="Resource" id="Resource_6nkgi"]
script = ExtResource("1_mkhkr")
id = "accept_double"
label_zh = "承认：我只想做个合乎规矩的庸人"
label_en = "Admit: I only want to be ordinary and obedient"
on_success = Array[ExtResource("2_m6wmn")]([SubResource("Resource_dues1"), SubResource("Resource_ibifg")])
result_text_zh = "镜中的人满意地点头，把一张二等核算主任的任命书贴在玻璃另一侧。可你伸手去接时，摸到的仍是自己冰凉的指尖。没有两箱腹透液，没有暖房，也没有谁真来赦免你；只有你终于承认，所谓庸人的幸福，有时不过是不再追问别人被运去了哪里。"
result_text_en = "You accept his respectable appointment and find only your own cold fingertips. The comfort is real for one moment: the comfort of no longer asking where the trains go."

