[sub_resource type="Resource" id="Resource_qy638"]
script = ExtResource("1_mkhkr")
id = "defy_double"
label_zh = "回答：拉娜不是一行油墨"
label_en = "Answer: Lana is not a line of ink"
on_success = Array[ExtResource("2_m6wmn")]([SubResource("Resource_v038n"), SubResource("Resource_iqmff"), SubResource("Resource_dy6e8")])
result_text_zh = "你一拳砸向那张温和的笑脸。镜子裂开，每一片里却仍坐着一个戴蓝袖章的你；血流进掌纹时，他们齐声纠正：「是 0420。」你疼得发抖，却第一次敢直视那些碎片：「不。她先是我妹妹，然后才是你们的一行字。」白昼的幻象消失了，冻疮和罪却一样也没有少。"
result_text_en = "You strike the mirror. Every fragment answers \"0420,\" but you insist she was your sister before she was their ink. The vision vanishes; your wounds and guilt remain."

[sub_resource type="Resource" id="Resource_dues1"]
script = ExtResource("2_m6wmn")
