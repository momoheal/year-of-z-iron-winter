label_en = "Begged the double"

[sub_resource type="Resource" id="Resource_g2t7m"]
script = ExtResource("1_mkhkr")
id = "beg_double"
label_zh = "跪下，求那个体面的自己替你决定"
label_en = "Kneel and let your respectable self decide"
on_success = Array[ExtResource("2_m6wmn")]([SubResource("Resource_dewjd"), SubResource("Resource_cosbk")])
result_text_zh = "你跪下来，求他告诉你究竟怎样才算无罪。蓝袖章的幻影俯身扶你，动作温柔得像一位兄长：「你看，阿廖沙，连你的反抗也需要我批准。只要你还只想证明自己是个好人，你就永远是我的。」你猛然抬头，镜前却只剩一个人跪着，分不清刚才被扶起的是身体，还是最后一点抵抗。"
result_text_en = "You beg him for innocence. He gently replies that even your rebellion needs his approval so long as you only wish to prove yourself good. When you look up, only one man is kneeling."

[resource]
script = ExtResource("3_rn0w3")
id = "mirror_double"
title_zh = "锅炉房镜子里的核算员"
title_en = "The Clerk in the Boiler-Room Mirror"
desc_zh = "午夜一点，你刚在《双面工作日志》背面划下一道血痕，锅炉房结霜的破镜里便走出另一个阿列克谢：蓝袖章、雪亮眼镜、体面铁路制服，连指甲缝也没有煤灰。他坐上蒸汽管，温和得像来探病的旧友：「阿廖沙，何必呢？拉娜已经是一行 0420 的油墨，你救不出墨水。把古丽娅那三页废纸交给督察官吧，你能换两箱瑞士 409 批腹透液，还能升任二等核算主任。妈能多活三年，你也能睡在有暖气的屋子里——做个合乎规矩的庸人有什么错？为什么非要当个满手冻疮的圣徒？」他没有辱骂你，也没有撒谎；正因如此，你才想立刻杀死他。"
desc_en = "At 01:00 a blue-armbanded Aleksei steps from the frosted boiler-room mirror: clean uniform, bright glasses, no soot beneath his nails. Trade Gulya's pages for dialysis fluid and promotion, he says; Lana is already ink. His gentleness is worse than mockery because none of his arithmetic is false."
phase = "night"
trigger_chance = 0.75
art_tag = "double"
options = Array[ExtResource("1_mkhkr")]([SubResource("Resource_qy638"), SubResource("Resource_6nkgi"), SubResource("Resource_g2t7m")])
